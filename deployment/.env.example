# =============================================================================
# 404seo — Variables d'environnement (exemple)
# =============================================================================
# Copier ce fichier vers .env.production à la racine et remplir les valeurs
#
# Generer un secret : openssl rand -base64 32
# =============================================================================

# ── Base de donnees ───────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/seo_saas"

# ── Auth (BetterAuth) ─────────────────────────────────────────────────────────
BETTER_AUTH_SECRET="<openssl rand -base64 32>"
BETTER_AUTH_URL="https://seo.404notfood.fr"
NEXT_PUBLIC_APP_URL="https://seo.404notfood.fr"

# ── API Fastify ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="https://seo.404notfood.fr"
API_PORT=4000
API_HOST=127.0.0.1
# Origines exactes des extensions Chrome autorisées (ID stable après publication)
CHROME_EXTENSION_ORIGINS=""

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=  # si Redis est protege par mot de passe

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_AGENCY=price_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── Google OAuth (optionnel) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="https://seo.404notfood.fr/api/google/callback"

# Emails (vérification des inscriptions et récupération de mot de passe)
RESEND_API_KEY=
EMAIL_FROM="404 SEO <noreply@seo.404notfood.fr>"

# IA optionnelle
ANTHROPIC_API_KEY=
# Utiliser le Chromium installé par Puppeteer ou définir ce chemin explicitement
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
